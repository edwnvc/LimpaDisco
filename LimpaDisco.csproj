<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>assets\icone.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- a página e as batalhas vão dentro do .exe; o programa as serve pelo nome curto (LogicalName) -->
    <EmbeddedResource Include="src\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="src\batalha.js" LogicalName="batalha.js" />
    <EmbeddedResource Include="src\batalha2.js" LogicalName="batalha2.js" />
    <EmbeddedResource Include="src\batalha3.js" LogicalName="batalha3.js" />
    <EmbeddedResource Include="src/batalha4.js" LogicalName="batalha4.js" />
    <EmbeddedResource Include="src/batalha5.js" LogicalName="batalha5.js" />
    <EmbeddedResource Include="assets\musicas\desvio.mp3" LogicalName="musica" />
    <EmbeddedResource Include="assets\musicas\duelo-clawd.mp3" LogicalName="musica2" />
    <EmbeddedResource Include="assets\musicas\batalha-3d.mp3" LogicalName="musica3" />
    <EmbeddedResource Include="assets\musicas\vitoria-3d.mp3" LogicalName="musica4" />
    <EmbeddedResource Include="assets\musicas\chefao.mp3" LogicalName="musica5" />
    <EmbeddedResource Include="assets/musicas/psicodelica.mp3" LogicalName="musica6" />
    <!-- efeitos sonoros: assets/sons/x.mp3 vira o recurso "som-x" -->
    <EmbeddedResource Include="assets/sons/*.mp3" LogicalName="som-%(Filename)" />
    <EmbeddedResource Include="assets/fundos/*.webm" LogicalName="fundo-%(Filename)" />
    <EmbeddedResource Include="assets/guitarra/*.png" LogicalName="guitarra-%(Filename)" />
    <!-- músicas do Clone Hero para a batalha de ritmo: uma pasta por música -->
    <EmbeddedResource Include="assets/ritmo/**/*.*" LogicalName="ritmo/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
